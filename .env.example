# Copie este arquivo para ".env" e ajuste os valores. Cada máquina (dev, QA, produção) tem o seu.
# Depois de editar, aplique com: docker compose up -d

# ── Obrigatório ──────────────────────────────────────────────────────────
# Um valor diferente para cada chave, e um conjunto diferente por máquina. Gerar:
#   docker run --rm --entrypoint python apache/airflow:3.3.2 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=
JWT_SECRET=
SECRET_KEY=

# ── Usuário administrador da tela do Airflow ────────────────────────────
# Troque a senha em qualquer ambiente além do dev local.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ── Portas publicadas no host ────────────────────────────────────────────
# Só precisam mudar quando mais de um ambiente é executado na mesma máquina (por exemplo, dev na 8080, QA na 8081).
AIRFLOW_WEBSERVER_PORT=8080
FLOWER_PORT=5555

# ── Outros ────────────────────────────────────────────────────────────────
# ID do usuário do sistema dentro dos containers. Linux: execute `id -u` e utilize o número retornado.
# Windows e Mac: mantenha 50000.
AIRFLOW_UID=50000
AIRFLOW_DEFAULT_TIMEZONE=UTC
